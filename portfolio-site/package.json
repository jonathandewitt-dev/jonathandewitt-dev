{
	"name": "jonathan-dewitt",
	"version": "1.0.0",
	"description": "Jonathan DeWitt’s portfolio: developer tools, web standards, and engineering experience.",
	"license": "ISC",
	"author": "Jonathan DeWitt",
	"type": "module",
	"main": "index.js",
	"engines": {
		"node": ">=24.21.0"
	},
	"scripts": {
		"start": "serve dist",
		"dev": "thunderous dev",
		"build": "thunderous build",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --check .",
		"format:fix": "prettier --write . --list-different",
		"typecheck": "tsc --noEmit",
		"test": "pnpm test:unit && pnpm test:components && pnpm test:e2e",
		"test:unit": "node --test --experimental-test-coverage --test-coverage-include=src/result.ts --test-coverage-include=src/routes.ts --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 tests/unit/*.test.ts",
		"test:components": "vitest run --config vitest.config.ts",
		"test:e2e": "playwright test",
		"storybook": "storybook dev --port 6006 --no-open --disable-telemetry",
		"build:storybook": "storybook build --output-dir storybook-static --disable-telemetry"
	},
	"devDependencies": {
		"@eslint/css": "^0.13.0",
		"@eslint/js": "^9.38.0",
		"@eslint/json": "^0.13.2",
		"@playwright/test": "^1.64.0",
		"@storybook/addon-vitest": "^10.6.2",
		"@storybook/web-components-vite": "^10.6.2",
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/express": "^5.0.3",
		"@types/node": "^24.9.1",
		"@typescript-eslint/eslint-plugin": "^8.46.2",
		"@vitest/browser-playwright": "^5.0.4",
		"eslint": "^9.38.0",
		"lit": "^3.3.3",
		"prettier": "^3.6.2",
		"serve": "^14.2.5",
		"storybook": "^10.6.2",
		"thunderous-server": "0.0.17",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.2",
		"undici-types": "^7.16.0",
		"vite": "^8.3.4",
		"vitest": "^5.0.4"
	},
	"dependencies": {
		"thunderous": "^2.4.6",
		"thunderous-csr": "^0.0.8"
	}
}
